# Copy to .env for Docker Compose. Never commit .env.
# Local Docker demo: set DEMO_MODE=true, SECURE_COOKIE=false, APP_ORIGIN=http://localhost:8088.
# Production: DEMO_MODE=false, SECURE_COOKIE=true, APP_ORIGIN=https://your-domain.example.
APP_ORIGIN=http://localhost:8088
WEB_PORT=8088
DEMO_MODE=false
SECURE_COOKIE=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_USER=careerx
DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=jdbc:postgresql://localhost:5432/careerx
AI_PROVIDER=compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@your-domain.example
# Optional path to a TrueType font for PDF export. Container has DejaVu Sans.
PDF_FONT_PATH=
# Peer Practice: TURN relay is needed for calls across restrictive Wi-Fi/mobile networks.
PEER_STUN_URL=stun:stun.l.google.com:19302
PEER_TURN_URLS=
# Use either a coturn shared secret OR a managed provider's TURN username/password.
PEER_TURN_SECRET=
PEER_TURN_USERNAME=
PEER_TURN_PASSWORD=
